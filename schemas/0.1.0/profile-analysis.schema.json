{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masa.sonicfield.org/schemas/0.1.0/profile-analysis.schema.json",
  "title": "MASA 0.1.0 Analysis profile",
  "allOf": [
    { "$ref": "matter-record.schema.json" },
    {
      "properties": {
        "profiles": { "contains": { "const": "analysis" } }
      },
      "anyOf": [
        { "properties": { "measurements": { "minItems": 1 } } },
        { "properties": { "regions": { "minItems": 1 } } }
      ]
    }
  ]
}
