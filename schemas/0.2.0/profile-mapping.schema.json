{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masa.sonicfield.org/schemas/0.2.0/profile-mapping.schema.json",
  "title": "MASA 0.2.0 Mapping profile",
  "allOf": [
    { "$ref": "matter-record.schema.json" },
    {
      "properties": {
        "profiles": { "contains": { "const": "mapping" } },
        "observations": { "minItems": 1 },
        "mappings": { "minItems": 1 }
      }
    }
  ]
}
