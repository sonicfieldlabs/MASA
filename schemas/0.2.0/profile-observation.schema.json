{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masa.sonicfield.org/schemas/0.2.0/profile-observation.schema.json",
  "title": "MASA 0.2.0 Observation profile",
  "allOf": [
    { "$ref": "matter-record.schema.json" },
    {
      "properties": {
        "profiles": { "contains": { "const": "observation" } },
        "sources": { "minItems": 1 },
        "observations": {
          "minItems": 1,
          "items": {
            "required": ["epistemicStatus", "temporalCharacter", "signalKind"]
          }
        }
      }
    }
  ]
}
