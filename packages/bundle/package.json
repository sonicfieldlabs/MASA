{
  "name": "@sonicfield/masa-bundle",
  "version": "0.1.0",
  "description": "Deterministic, bounded MASA directory and ZIP bundle tooling",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@sonicfield/masa": "workspace:*",
    "@sonicfield/masa-validator": "workspace:*",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1"
  },
  "engines": {
    "node": ">=22.20"
  }
}
