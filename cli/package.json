{
  "name": "@sonicfield/masa-cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local command-line reference implementation for MASA",
  "type": "module",
  "bin": {
    "masa": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@sonicfield/masa": "workspace:*",
    "@sonicfield/masa-bundle": "workspace:*",
    "@sonicfield/masa-validator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.20"
  }
}
